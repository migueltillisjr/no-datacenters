# Copy this file to .env and replace every CHANGEME value before starting.
LANGFUSE_IMAGE_TAG=4

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD
POSTGRES_DB=postgres

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME_CLICKHOUSE_PASSWORD

REDIS_AUTH=CHANGEME_REDIS_PASSWORD

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME_MINIO_PASSWORD

NEXTAUTH_SECRET=CHANGEME_NEXTAUTH_SECRET
SALT=CHANGEME_SALT
ENCRYPTION_KEY=CHANGEME_64_HEX_ENCRYPTION_KEY

# Harness observability credentials.
# Create a Langfuse project at http://localhost:3000 after the stack starts,
# then replace these placeholders with that project's API keys.
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_BASE_URL=http://localhost:3000
# OpenCode uses this legacy spelling.
LANGFUSE_BASEURL=http://localhost:3000
LANGFUSE_ENVIRONMENT=development
# Optional stable, non-secret identifier used to filter traces by user.
# Do not use a password, API token, or Langfuse secret key here.
LANGFUSE_USER_ID=harness

# Claude Code and Codex tracing are opt-in.
TRACE_TO_LANGFUSE=false

# GitHub Copilot CLI uses native OpenTelemetry export instead of a plugin.
COPILOT_OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
# Generate after setting the public and secret keys:
# export OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic $(printf '%s' \"$LANGFUSE_PUBLIC_KEY:$LANGFUSE_SECRET_KEY\" | base64),x-langfuse-ingestion-version=4"
